# Path to the SQLite database
NBA_PROJECTOR_DB_PATH=data/projector.db
# Directory for raw nba_api responses
NBA_PROJECTOR_RAW_DIR=data/raw
# My roster file (see roster.example.json)
NBA_PROJECTOR_ROSTER_PATH=data/roster.json

# Yahoo Fantasy API (optional). See the README section "Yahoo league".
NBA_PROJECTOR_YAHOO_CLIENT_ID=
NBA_PROJECTOR_YAHOO_CLIENT_SECRET=
# Must match the redirect URI in your Yahoo app exactly
NBA_PROJECTOR_YAHOO_REDIRECT_URI=https://localhost:8000
# Numbers from your league and team page URLs
NBA_PROJECTOR_YAHOO_LEAGUE_ID=
NBA_PROJECTOR_YAHOO_TEAM_ID=
# Where the sign-in token is stored (keep out of git; data/ is ignored)
NBA_PROJECTOR_YAHOO_TOKEN_PATH=data/yahoo_token.json
